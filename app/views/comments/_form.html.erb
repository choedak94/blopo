<%= form_with model: Comment.new, url: comments_path, local: true do |f| %>
  <%= f.hidden_field :blog_post_id, value: blog_post.id %>
  <% if parent %>
    <%= f.hidden_field :parent_id, value: parent.id %>
  <% end %>
  <div class="my-2">
    <%= f.text_area :body, rows: 3, class: "w-full border rounded", placeholder: "Add a comment" %>
  </div>
  <div class="flex space-x-2">
    <%= f.submit 'Post', class: 'bg-blue-500 text-black px-3 py-1 rounded' %>
    <% if parent %>
      <button type="button" data-action="reply-form#toggle" class="bg-gray-200 px-3 py-1 rounded">Cancel</button>
    <% end %>
  </div>
<% end %>

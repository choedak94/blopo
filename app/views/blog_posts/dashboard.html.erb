<div class="m-8 max-w-6xl mx-auto">
  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 mt-5">
    <% @blog_posts.each do |blog| %>
      <div>
        <div class="group relative aspect-video overflow-hidden rounded-lg bg-gray-100">
          <% image = blog.content.embeds.find { |embed| embed.image? } %>
          <% if image.present? %>
            <%= image_tag image.variant(resize_to_limit: [640, 360]), alt: "", class: "object-cover w-full h-full group-hover:opacity-75" %>
          <% else %>
            <img src="https://images.unsplash.com/photo-1582053433976-25c00369fc93?auto=format&fit=crop&w=640&q=80" alt="" class="object-cover w-full h-full group-hover:opacity-75">
          <% end %>
          <%= link_to blog, class: "absolute inset-0" do %>
            <span class="sr-only"><%= blog.title %></span>
          <% end %>
        </div>
        <p class="mt-2 text-sm font-semibold text-gray-900 truncate"><%= blog.title.capitalize %></p>
        <p class="text-sm text-gray-500"><%= blog.user.username %></p>
        <p class="text-sm text-gray-500"><%= blog.published_at&.to_date %></p>
      </div>
    <% end %>
  </div>
</div>
<div class="my-8 flex justify-center">
  <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
</div>

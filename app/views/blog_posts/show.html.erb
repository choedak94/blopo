<div class="max-w-5xl mx-auto mt-6">
  <% if @blog_post.video.attached? %>
    <div class="aspect-video bg-black">
      <%= video_tag @blog_post.video, controls: true, class: 'w-full h-full' %>
    </div>
  <% end %>

  <div class="mt-4 space-y-4 px-2">
    <div class="flex justify-between items-start">
      <div>
        <h1 class="text-2xl font-bold"><%= @blog_post.title %></h1>
        <p class="text-sm text-gray-500">Uploaded at <%= l(@blog_post.created_at, format: :short) %> by <%= @blog_post.user.username %></p>
      </div>
      <% if current_user == @blog_post.user %>
        <%= link_to edit_blog_post_path(@blog_post), class: 'p-2 rounded-full hover:bg-gray-100' do %>
          <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
          </svg>
        <% end %>
      <% end %>
    </div>

    <div class="prose max-w-none text-gray-700">
      <%= simple_format(@blog_post.description) %>
    </div>

    <%= turbo_frame_tag dom_id(@blog_post, :votes) do %>
      <%= render 'blog_posts/vote_buttons', blog_post: @blog_post %>
    <% end %>

    <% if user_signed_in? %>
      <div class="mt-6">
        <%= render 'comments/form', blog_post: @blog_post, parent: nil %>
      </div>
    <% else %>
      <p class="text-sm text-gray-500 mt-6">Please <%= link_to 'sign in', new_user_session_path, class: 'text-blue-600' %> to add a comment.</p>
    <% end %>

    <div class="mt-8 space-y-4">
      <% @blog_post.comments.where(parent_id: nil).each do |comment| %>
        <div class="border-t pt-4">
          <%= render 'comments/comment', comment: comment %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<div class="max-w-5xl mx-auto mt-8">
  <% if @blog_post.video.attached? %>
    <div class="aspect-video bg-black">
      <%= video_tag @blog_post.video, controls: true, class: "w-full h-full" %>
    </div>
  <% end %>

  <div class="mt-4 space-y-3 px-2">
    <h1 class="text-xl font-semibold"><%= @blog_post.title %></h1>
    <div class="flex items-center justify-between text-sm text-gray-500">
      <span>Uploaded <%= l(@blog_post.created_at, format: :short) %></span>
      <% if current_user == @blog_post.user %>
        <%= link_to edit_blog_post_path(@blog_post), class: "text-blue-600 hover:underline" do %>
          Edit
        <% end %>
      <% end %>
    </div>
    <div class="prose">
      <%= simple_format(@blog_post.description) %>
    </div>
    <p class="text-sm text-gray-500">Author: <%= @blog_post.user.username %></p>

    <%= turbo_frame_tag dom_id(@blog_post, :votes) do %>
      <%= render 'blog_posts/vote_buttons', blog_post: @blog_post %>
    <% end %>

    <% if user_signed_in? %>
      <div class="mt-6">
        <%= render 'comments/form', blog_post: @blog_post, parent: nil %>
      </div>
    <% else %>
      <p class="text-sm text-gray-500 mt-6">Please <%= link_to 'sign in', new_user_session_path, class: 'text-blue-600' %> to add a comment.</p>
    <% end %>

    <div class="mt-8 space-y-4">
      <% @blog_post.comments.where(parent_id: nil).each do |comment| %>
        <div class="border-t pt-4">
          <%= render 'comments/comment', comment: comment %>
        </div>
      <% end %>
    </div>
  </div>
</div>

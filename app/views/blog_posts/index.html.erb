<div class="mx-auto max-w-7xl px-4 py-6">
  <div class="flex justify-end mb-4">
    <% if user_signed_in? %>
      <%= link_to new_blog_post_path, class: "rounded-full bg-blue-500 p-1.5 text-white shadow hover:bg-blue-600" do %>
        <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z" />
        </svg>
      <% end %>
    <% end %>
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
    <% @blog_posts.each do |blog| %>
      <div class="bg-white rounded-lg shadow overflow-hidden">
        <div class="aspect-video bg-black">
          <% if blog.video.attached? %>
            <%= video_tag blog.video, controls: false, preload: :metadata, class: "w-full h-full object-cover" %>
          <% else %>
            <img src="https://images.unsplash.com/photo-1582053433976-25c00369fc93?auto=format&fit=crop&w=512&q=80" alt="" class="w-full h-full object-cover">
          <% end %>
        </div>
        <div class="p-2">
          <%= link_to blog, class: "font-semibold block truncate" do %>
            <%= blog.title.capitalize %>
          <% end %>
          <p class="text-sm text-gray-500"><%= blog.user.username %></p>
          <p class="text-sm text-gray-500"><%= blog.published_at %></p>
        </div>
      </div>
    <% end %>
  </div>
  <div class="my-8 flex justify-center">
    <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
  </div>
</div>

<div class="m-8">
  <div class="flex justify-end mb-4">
    <% if user_signed_in? %>
      <%= link_to new_blog_post_path, class: "flex items-center space-x-2 bg-blue-500 hover:bg-blue-600 text-white rounded px-4 py-2" do %>
        <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        <span>Upload</span>
      <% end %>
    <% end %>
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 mt-5">
                <% @blog_posts.each do |blog| %>
                        <div>
                                <div class="group aspect-h-7 aspect-w-10 block w-full overflow-hidden rounded-lg bg-gray-100 focus-within:ring-2 focus-within:ring-indigo-500 focus-within:ring-offset-2 focus-within:ring-offset-gray-100">
                                  <% if blog.video.attached? %>
                                    <%= video_tag blog.video, controls: false, preload: :metadata, class: "pointer-events-none object-cover group-hover:opacity-75" %>
                                  <% else %>
                                    <img src="https://images.unsplash.com/photo-1582053433976-25c00369fc93?ixid=MXwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHw%3D&ixlib=rb-1.2.1&auto=format&fit=crop&w=512&q=80" alt="" class="pointer-events-none object-cover group-hover:opacity-75">
                                  <% end %>
                                  <%= link_to blog, class: "absolute inset-0 focus:outline-none" do %>
                                    <span class="sr-only"><%= blog.title %></span>
                                  <% end %>
                                </div>
                                <p class="pointer-events-none mt-2 block truncate text-sm font-semibold text-gray-900"><%= blog.title.capitalize %></p>
                                <p class="pointer-events-none text-xs text-gray-500"><%= blog.user.username %> · <%= blog.published_at %></p>
                        </div>
                <% end %>
  </div>
</div>
<div class="my-8 flex justify-center">
  <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
</div>

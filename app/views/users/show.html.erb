<div class="m-8">
  <h1 class="text-3xl font-bold mb-2"><%= @user.username %></h1>
  <p class="text-gray-600 mb-4"><%= @user.email %></p>
  <% if user_signed_in? && current_user == @user %>
    <%= link_to 'Edit profile', edit_user_registration_path, class: 'text-indigo-600 hover:underline' %>
  <% end %>

  <h2 class="text-2xl font-semibold mt-8 mb-4">Blog Posts</h2>
  <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
    <% @blog_posts.each do |blog| %>
      <div>
        <%= link_to blog do %>
          <p class="font-semibold"><%= blog.title.capitalize %></p>
        <% end %>
        <p class="text-sm text-gray-500"><%= blog.published_at %></p>
      </div>
    <% end %>
  </div>
  <div class="my-8 flex justify-center">
    <%== pagy_nav(@pagy) if @pagy.pages > 1 %>
  </div>
</div>

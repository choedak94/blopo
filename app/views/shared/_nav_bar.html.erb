<nav class="sticky top-0 z-10 bg-white shadow" data-controller="mobile-menu">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">
      <div class="flex items-center space-x-2">
        <%= link_to dashboard_blog_posts_path, class: "flex items-center" do %>
          <%= image_tag "logo.png", alt: 'blopo logo', class: "h-6 w-6 mr-1" %>
          <span class="font-bold text-xl">BloPo</span>
        <% end %>
      </div>

      <div class="flex-1 hidden md:block px-4">
        <%= form_with url: request.path, method: :get, local: true do |f| %>
          <div class="relative">
            <%= f.text_field :q, value: params[:q], placeholder: "Search", class: "w-full rounded-full border border-gray-300 py-2 pl-4 pr-10 focus:border-blue-500 focus:ring-blue-500" %>
            <button type="submit" class="absolute inset-y-0 right-0 flex items-center pr-3">
              <svg class="h-5 w-5 text-gray-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35m0 0A7.5 7.5 0 104.5 4.5a7.5 7.5 0 0012.15 12.15z" />
              </svg>
            </button>
          </div>
        <% end %>
      </div>

      <div class="flex items-center space-x-4">
        <% if user_signed_in? %>
          <%= link_to new_blog_post_path, class: "hidden md:block p-2 rounded-full hover:bg-gray-100" do %>
            <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
          <% end %>
          <%= link_to blog_posts_path do %>
            <span class="hidden md:block">My Videos</span>
          <% end %>
          <%= link_to user_path(current_user) do %>
            <span class="hidden md:block">Profile</span>
          <% end %>
          <%= button_to destroy_user_session_path, method: :delete do %>
            <span class="hidden md:block">Log out</span>
          <% end %>
        <% else %>
          <%= link_to user_session_path do %>
            <span class="hidden md:block">Login</span>
          <% end %>
          <%= link_to new_user_registration_path do %>
            <span class="hidden md:block bg-blue-500 text-white px-3 py-1 rounded">Signup</span>
          <% end %>
        <% end %>

        <button class="md:hidden mobile-menu-button" data-action="click->mobile-menu#toggleMenu">
          <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div class="mobile-menu hidden md:hidden" data-mobile-menu-target="menu">
    <% if user_signed_in? %>
      <%= link_to new_blog_post_path do %>
        <span class="block py-2 px-4 text-sm hover:bg-gray-200">Upload</span>
      <% end %>
      <%= link_to blog_posts_path do %>
        <span class="block py-2 px-4 text-sm hover:bg-gray-200">My Videos</span>
      <% end %>
      <%= link_to user_path(current_user) do %>
        <span class="block py-2 px-4 text-sm hover:bg-gray-200">Profile</span>
      <% end %>
      <%= button_to destroy_user_session_path, method: :delete do %>
        <span class="block py-2 px-4 text-sm hover:bg-gray-200">Log out</span>
      <% end %>
    <% else %>
      <%= link_to user_session_path do %>
        <span class="block py-2 px-4 text-sm hover:bg-gray-200">Login</span>
      <% end %>
      <%= link_to new_user_registration_path do %>
        <span class="block py-2 px-4 font-bold hover:bg-gray-200">Signup</span>
      <% end %>
    <% end %>
  </div>
</nav>

<nav class="bg-gray-100 md:w-56 md:min-h-screen" data-controller="mobile-menu">
  <div class="flex items-center justify-between p-4 border-b md:block md:border-b-0">
    <%= link_to dashboard_blog_posts_path, class: "flex items-center text-gray-700 hover:text-gray-900" do %>
      <%= image_tag("logo.png", alt: 'blopo logo', class: "h-6 w-6 mr-1") %>
      <span class="font-bold">BloPo</span>
    <% end %>

    <button class="md:hidden mobile-menu-button" data-action="click->mobile-menu#toggleMenu">
      <svg class="w-6 h-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <div class="mobile-menu hidden md:block md:mt-4" data-mobile-menu-target="menu">
    <% if user_signed_in? %>
      <%= link_to user_path(current_user), class: "block px-4 py-2 hover:bg-gray-200" do %>
        Profile
      <% end %>
      <%= link_to blog_posts_path, class: "block px-4 py-2 hover:bg-gray-200" do %>
        My Blog
      <% end %>
      <%= button_to destroy_user_session_path, method: :delete, class: "w-full text-left px-4 py-2 hover:bg-gray-200" do %>
        Log out
      <% end %>
    <% else %>
      <%= link_to user_session_path, class: "block px-4 py-2 hover:bg-gray-200" do %>
        Login
      <% end %>
      <%= link_to new_user_registration_path, class: "block px-4 py-2 font-bold hover:bg-gray-200" do %>
        Signup
      <% end %>
    <% end %>
  </div>
</nav>

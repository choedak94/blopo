<nav class="bg-white border-b" data-controller="mobile-menu">
  <div class="max-w-7xl mx-auto flex items-center justify-between h-14 px-4">
    <div class="flex items-center space-x-2">
      <%= link_to dashboard_blog_posts_path, class: "flex items-center space-x-1" do %>
        <%= image_tag('logo.png', alt: 'blopo logo', class: 'h-6 w-6') %>
        <span class="font-semibold text-xl">BloPo</span>
      <% end %>
    </div>

    <div class="flex-1 px-4">
      <%= form_with url: blog_posts_path, method: :get, local: true, class: "flex" do |f| %>
        <%= f.text_field :q, value: params[:q], placeholder: 'Search', class: 'w-full border border-gray-300 rounded-l-full px-4 py-1 focus:ring-1 focus:ring-blue-500 focus:border-blue-500' %>
        <%= f.submit 'Search', class: 'bg-gray-100 border border-gray-300 rounded-r-full px-4' %>
      <% end %>
    </div>

    <div class="hidden md:flex items-center space-x-4">
      <% if user_signed_in? %>
        <%= link_to new_blog_post_path, class: 'p-2 rounded-full hover:bg-gray-100' do %>
          <svg class="h-6 w-6 text-gray-700" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z" />
          </svg>
        <% end %>
        <%= link_to user_path(current_user), class: 'text-sm' do %>Profile<% end %>
        <%= button_to destroy_user_session_path, method: :delete, class: 'text-sm' do %>Log out<% end %>
      <% else %>
        <%= link_to user_session_path, class: 'text-sm' do %>Login<% end %>
        <%= link_to new_user_registration_path, class: 'text-sm font-semibold' do %>Signup<% end %>
      <% end %>
    </div>

    <div class="md:hidden flex items-center">
      <button class="mobile-menu-button" data-action="click->mobile-menu#toggleMenu">
        <svg class="w-6 h-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <div class="mobile-menu hidden md:hidden" data-mobile-menu-target="menu">
    <div class="px-4 pt-2 pb-3 space-y-1">
      <% if user_signed_in? %>
        <%= link_to user_path(current_user) do %>
          <span class="block py-2 px-4 text-sm hover:bg-gray-100">Profile</span>
        <% end %>
        <%= button_to destroy_user_session_path, method: :delete do %>
          <span class="block py-2 px-4 text-sm hover:bg-gray-100">Log out</span>
        <% end %>
      <% else %>
        <%= link_to user_session_path do %>
          <span class="block py-2 px-4 text-sm hover:bg-gray-100">Login</span>
        <% end %>
        <%= link_to new_user_registration_path do %>
          <span class="block py-2 px-4 text-sm hover:bg-gray-100">Signup</span>
        <% end %>
      <% end %>
    </div>
  </div>
</nav>

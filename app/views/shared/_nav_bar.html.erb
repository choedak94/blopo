<nav class="md:w-60 bg-white border-t md:border-t-0 md:border-r shadow fixed bottom-0 inset-x-0 md:static md:h-full flex justify-around md:flex-col md:justify-start md:py-6 z-20" data-controller="mobile-menu">
  <!-- Logo shown only on md and up -->
  <div class="hidden md:flex items-center mb-6 px-4">
    <%= link_to dashboard_blog_posts_path, class: "flex items-center" do %>
      <svg class="h-6 w-6 text-red-600" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M10 16.5l6-4.5-6-4.5v9z" />
      </svg>
      <span class="ml-1 text-xl font-semibold">BloPo</span>
    <% end %>
  </div>

  <!-- Desktop search -->
  <div class="hidden md:block px-4 mb-4">
    <%= form_with url: dashboard_blog_posts_path, method: :get, local: true, class: "flex w-full" do |f| %>
      <%= f.text_field :q, value: params[:q], placeholder: "Search", class: "flex-1 border rounded-l-full px-4 py-1" %>
      <%= f.submit "Search", class: "px-4 py-1 bg-blue-500 text-white rounded-r-full" %>
    <% end %>
  </div>

  <!-- Links -->
  <div class="flex flex-1 md:flex-col items-center md:items-start md:space-y-4 justify-around w-full px-4">
    <%= link_to dashboard_blog_posts_path, class: "flex flex-col md:flex-row items-center md:w-full md:px-2 md:py-2 hover:bg-gray-100 rounded" do %>
      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M3 9.75L12 4l9 5.75V19a2 2 0 01-2 2h-5a2 2 0 01-2-2v-5H9v5a2 2 0 01-2 2H5a2 2 0 01-2-2V9.75z" />
      </svg>
      <span class="text-xs md:text-base md:ml-2">Home</span>
    <% end %>

    <!-- Mobile search button -->
    <button class="md:hidden flex flex-col items-center" data-action="click->mobile-menu#toggleMenu">
      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8" />
        <line x1="21" y1="21" x2="16.65" y2="16.65" />
      </svg>
      <span class="text-xs">Search</span>
    </button>

    <% if user_signed_in? %>
      <%= link_to new_blog_post_path, class: "flex flex-col md:flex-row items-center md:w-full md:px-2 md:py-2 hover:bg-gray-100 rounded" do %>
        <svg class="h-6 w-6" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z" />
        </svg>
        <span class="text-xs md:text-base md:ml-2">Upload</span>
      <% end %>
      <%= link_to user_path(current_user), class: "flex flex-col md:flex-row items-center md:w-full md:px-2 md:py-2 hover:bg-gray-100 rounded" do %>
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 12c2.7 0 5-2.3 5-5s-2.3-5-5-5-5 2.3-5 5 2.3 5 5 5zm0 2c-3.3 0-10 1.7-10 5v3h20v-3c0-3.3-6.7-5-10-5z" />
        </svg>
        <span class="text-xs md:text-base md:ml-2">Profile</span>
      <% end %>
      <%= button_to destroy_user_session_path, method: :delete, class: "hidden md:flex items-center w-full px-2 py-2 hover:bg-gray-100 rounded text-left" do %>
        Log out
      <% end %>
    <% else %>
      <%= link_to user_session_path, class: "flex flex-col md:flex-row items-center md:w-full md:px-2 md:py-2 hover:bg-gray-100 rounded" do %>
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 12c2.7 0 5-2.3 5-5s-2.3-5-5-5-5 2.3-5 5 2.3 5 5 5zm0 2c-3.3 0-10 1.7-10 5v3h20v-3c0-3.3-6.7-5-10-5z" />
        </svg>
        <span class="text-xs md:text-base md:ml-2">Login</span>
      <% end %>
      <%= link_to new_user_registration_path, class: "hidden md:flex items-center w-full px-2 py-2 hover:bg-gray-100 rounded" do %>
        Signup
      <% end %>
    <% end %>
  </div>
</nav>

<!-- Mobile search overlay -->
<div class="mobile-menu hidden md:hidden fixed inset-0 bg-black bg-opacity-50 z-30" data-mobile-menu-target="menu">
  <div class="bg-white p-4">
    <%= form_with url: dashboard_blog_posts_path, method: :get, local: true, class: "flex space-x-2" do |f| %>
      <%= f.text_field :q, value: params[:q], placeholder: "Search", class: "flex-1 border rounded-l-full px-4 py-1" %>
      <%= f.submit "Search", class: "px-4 py-1 bg-blue-500 text-white rounded-r-full" %>
    <% end %>
  </div>
</div>
